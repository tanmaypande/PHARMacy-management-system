# Application Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development

# Database Configuration (PostgreSQL 18 + psycopg 3)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/pharmacy_management

# Security (JWT Auth)
SECRET_KEY=change_this_to_a_secure_random_secret_key_for_jwt_tokens
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 hours standard shift duration
